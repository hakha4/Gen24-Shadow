# GEN24 shadow decision dataset - steg 2
# Read-only: publicerar inga MQTT-kommandon och anropar inga styrtjanster.
# Ett prov skapas nar firmware publicerar solar_timestamp, vilket sker efter
# effektvardena i samma publiceringscykel.

mqtt:
  sensor:
    - name: "GEN24 Shadow Raw Load"
      unique_id: gen24_shadow_raw_load
      state_topic: "gen24_shadow/sensor/solar_load_raw_w"
      unit_of_measurement: "W"
      device_class: power
      state_class: measurement
      icon: mdi:home-lightning-bolt-outline

    - name: "GEN24 Shadow Load Source Mode"
      unique_id: gen24_shadow_load_source_mode
      state_topic: "gen24_shadow/sensor/solar_load_source_mode"
      icon: mdi:source-branch

template:
  - trigger:
      - platform: mqtt
        topic: "gen24_shadow/sensor/solar_timestamp"
        id: firmware_sample
    sensor:
      - name: "GEN24 Shadow Decision Sample"
        unique_id: gen24_shadow_decision_sample
        icon: mdi:database-clock
        state: "{{ now().isoformat() }}"
        attributes:
          collection_stage: "2_DECISION_DATA_COLLECTION"
          commands_enabled: false
          command_topics_used: false
          firmware_timestamp: "{{ trigger.payload | trim }}"
          collected_at: "{{ now().isoformat() }}"
          control_mode: >-
            {{ state_attr('sensor.gen24_shadow_policy_observer', 'control_mode_live') | default('unknown', true) }}
          soc_pct: >-
            {{ state_attr('sensor.gen24_shadow_policy_observer', 'soc_pct') | float(0) }}
          pv_w: >-
            {{ state_attr('sensor.gen24_shadow_policy_observer', 'pv_w') | float(0) }}
          grid_w: >-
            {{ state_attr('sensor.gen24_shadow_policy_observer', 'grid_w') | float(0) }}
          load_w: >-
            {{ state_attr('sensor.gen24_shadow_policy_observer', 'load_w') | float(0) }}
          raw_load_w: >-
            {{ states('sensor.gen24_shadow_raw_load') | float(0) }}
          load_source_mode: >-
            {{ states('sensor.gen24_shadow_load_source_mode') }}
          raw_to_combined_delta_w: >-
            {% set load = state_attr('sensor.gen24_shadow_policy_observer', 'load_w') | float(0) %}
            {% set raw = states('sensor.gen24_shadow_raw_load') | float(0) %}
            {{ (load - raw) | round(1) }}
          battery_w: >-
            {{ state_attr('sensor.gen24_shadow_policy_observer', 'battery_w') | float(0) }}
          observed_action: >-
            {% set battery = state_attr('sensor.gen24_shadow_policy_observer', 'battery_w') | float(0) %}
            {% if battery <= -100 %}CHARGING
            {% elif battery >= 100 %}DISCHARGING
            {% else %}IDLE{% endif %}
          # Fronius-konvention i firmware: grid > 0 import, battery > 0
          # urladdning och battery < 0 laddning. Idealt galler da
          # load = pv + grid + battery. Residualen ar diagnostik, inte styrning.
          power_balance_residual_w: >-
            {% set pv = state_attr('sensor.gen24_shadow_policy_observer', 'pv_w') | float(0) %}
            {% set grid = state_attr('sensor.gen24_shadow_policy_observer', 'grid_w') | float(0) %}
            {% set load = state_attr('sensor.gen24_shadow_policy_observer', 'load_w') | float(0) %}
            {% set battery = state_attr('sensor.gen24_shadow_policy_observer', 'battery_w') | float(0) %}
            {{ (load - pv - grid - battery) | round(1) }}
          data_quality: >-
            {% set observer = states('sensor.gen24_shadow_policy_observer') %}
            {% set pv = state_attr('sensor.gen24_shadow_policy_observer', 'pv_w') %}
            {% set grid = state_attr('sensor.gen24_shadow_policy_observer', 'grid_w') %}
            {% set load = state_attr('sensor.gen24_shadow_policy_observer', 'load_w') %}
            {% set battery = state_attr('sensor.gen24_shadow_policy_observer', 'battery_w') %}
            {% set soc = state_attr('sensor.gen24_shadow_policy_observer', 'soc_pct') %}
            {% if observer != 'OBSERVING' or none in [pv, grid, load, battery, soc] %}
              INVALID
            {% else %}
              {% set residual = (load | float - pv | float - grid | float - battery | float) | abs %}
              {{ 'COHERENT' if residual <= 500 else 'REVIEW_BALANCE' }}
            {% endif %}
          evaluation_status: "COLLECTING_NOT_YET_SCORED"

      - name: "GEN24 Shadow Observed Action"
        unique_id: gen24_shadow_observed_action
        icon: mdi:battery-sync
        state: >-
          {% set battery = state_attr('sensor.gen24_shadow_policy_observer', 'battery_w') | float(0) %}
          {% if battery <= -100 %}CHARGING
          {% elif battery >= 100 %}DISCHARGING
          {% else %}IDLE{% endif %}
        attributes:
          firmware_timestamp: "{{ trigger.payload | trim }}"
          commands_enabled: false

      - name: "GEN24 Shadow Power Balance Residual"
        unique_id: gen24_shadow_power_balance_residual
        device_class: power
        unit_of_measurement: "W"
        state_class: measurement
        icon: mdi:scale-balance
        state: >-
          {% set pv = state_attr('sensor.gen24_shadow_policy_observer', 'pv_w') | float(0) %}
          {% set grid = state_attr('sensor.gen24_shadow_policy_observer', 'grid_w') | float(0) %}
          {% set load = state_attr('sensor.gen24_shadow_policy_observer', 'load_w') | float(0) %}
          {% set battery = state_attr('sensor.gen24_shadow_policy_observer', 'battery_w') | float(0) %}
          {{ (load - pv - grid - battery) | round(1) }}
        attributes:
          quality_limit_w: 500
          firmware_timestamp: "{{ trigger.payload | trim }}"
          commands_enabled: false
